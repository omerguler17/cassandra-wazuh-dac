<group name="syslog,sshd,">
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <match>sshd: auth internal error</match>
    <description>Cassandra Test: SSHD internal auth error detected.</description>
  </rule>

  <rule id="100002" level="10" frequency="8" timeframe="120">
    <if_matched_sid>5716</if_matched_sid>
    <same_source_ip />
    <description>Cassandra Test: SSH brute force trying to gain access.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>
</group>

<group name="syslog,sudo,">
  <rule id="100003" level="6">
    <if_sid>5402</if_sid>
    <match>NOT in sudoers</match>
    <description>Cassandra Test: User not in sudoers tried to run sudo command.</description>
    <mitre>
      <id>T1548.001</id>
    </mitre>
  </rule>
</group>

<group name="syslog,useradd,">
  <rule id="100004" level="7">
    <if_sid>5901</if_sid>
    <match>new user</match>
    <description>Cassandra Test: New user account created in the system.</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
  </rule>
</group>